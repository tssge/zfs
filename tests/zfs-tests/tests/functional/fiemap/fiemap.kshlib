. $STF_SUITE/include/libtest.shlib
. $STF_SUITE/tests/functional/fiemap/fiemap.cfg

function fiemap_cleanup
{
	fiemap_remove
}

function fiemap_write # blocksize count seek file
{
	typeset bs=$1
	typeset count=${2:-1}
	typeset seek=${3:-0}
	typeset fname=${4:-$FIEMAP_FILE}

	log_must dd if=/dev/urandom of=$fname \
	    bs=$bs count=$count seek=$seek conv=notrunc
}

# Half fill the blocks to produce a compressible file.
function fiemap_write_compressible # blocksize count seek file
{
	typeset bs=$1
	typeset count=${2:-1}
	typeset seek=${3:-0}
	typeset fname=${4:-$FIEMAP_FILE}

	for (( j = 1; j < $((count * 2)); j += 2 )); do
		fiemap_write $((bs / 2)) 1 $((seek * 2 + j)) $fname
	done
}

function fiemap_hole # blocksize count seek
{
	typeset bs=$1
	typeset count=${2:-1}
	typeset seek=${3:-0}
	typeset fname=${4:-$FIEMAP_FILE}

	log_must dd if=/dev/zero of=$fname \
	    bs=$bs count=$count seek=$seek conv=notrunc
}

function fiemap_free # blocksize count seek
{
	typeset bs=$1
	typeset count=${2:-1}
	typeset seek=${3:-0}
	typeset fname=${4:-$FIEMAP_FILE}

	log_must fallocate -p -n -l $((bs * count)) -o $((bs * seek)) $fname
}

function fiemap_remove # file
{
	typeset fname=${1:-$FIEMAP_FILE}

	rm -f $fname
}

function fiemap_verify # options
{
	if ! fiemap $@ $FIEMAP_FILE 2>/dev/null 2>&1; then
		zdb -vvvvv -O $TESTPOOL/$TESTFS $(basename $FIEMAP_FILE)
		log_must fiemap -v $@ $FIEMAP_FILE
	else
		log_must fiemap -v $@ $FIEMAP_FILE
	fi
}

function fiemap_get_vdev_asize # pool vdev-path
{
	typeset pool=$1
	typeset vdev=$2

	zpool list -v -p "$pool" | \
	    awk -v dev="$vdev" '$1 == dev { print $2; found = 1; exit }
	    END { if (!found) exit 1 }'
}

function fiemap_get_last_vdev # pool
{
	typeset pool=$1

	zpool list -v -p "$pool" | \
	    awk -v pool="$pool" '
	    $1 == pool { next }
	    $2 ~ /^[0-9]+$/ { last = $1 }
	    END { if (last == "") exit 1; print last }'
}

function fiemap_get_vdev_base # pool vdev-path
{
	typeset pool=$1
	typeset vdev=$2

	zpool list -v -p "$pool" | \
	    awk -v pool="$pool" -v dev="$vdev" '
	    BEGIN { running = 0 }
	    $1 == pool { next }
	    $2 !~ /^[0-9]+$/ { next }
	    {
		    if ($1 == dev) {
			    print running
			    found = 1
			    exit
		    }
		    running += $2
	    }
	    END { if (!found) exit 1 }'
}

#
# Verify source-vdev participation using linearized physical offsets.
# mode=lt requires at least one extent with start < limit.
# mode=ge requires no extents with start < limit (all >= limit).
# mode=ge_any requires at least one extent with start >= limit.
# mode=ge_none requires no extents with start >= limit.
#
function fiemap_verify_linearized_range # mode limit [file]
{
	typeset mode=$1
	typeset limit=$2
	typeset fname=${3:-$FIEMAP_FILE}
	typeset output
	typeset total=0
	typeset below=0

	output=$(fiemap -v -s "$fname")
	if [[ $? -ne 0 ]]; then
		echo "$output"
		return 1
	fi

	echo "$output"

	while read -r id _ _ phys_range _; do
		typeset phys_start
		typeset start

		case "$id" in
		''|*[!0-9]*)
			continue
			;;
		esac

		phys_start=${phys_range%%-*}
		phys_start=${phys_start#0x}
		start=$((16#$phys_start))

		total=$((total + 1))
		if [[ $start -lt $limit ]]; then
			below=$((below + 1))
		fi
	done <<-EOF
	$output
	EOF

	if [[ $total -eq 0 ]]; then
		return 1
	fi

	case "$mode" in
	lt)
		[[ $below -gt 0 ]] || return 1
		;;
	ge)
		[[ $below -eq 0 ]] || return 1
		;;
	ge_any)
		[[ $below -lt $total ]] || return 1
		;;
	ge_none)
		[[ $below -eq $total ]] || return 1
		;;
	*)
		return 1
		;;
	esac

	return 0
}
