#!/bin/ksh -p
# SPDX-License-Identifier: CDDL-1.0
#
# Common library for bclone_dedup (zfs recv -B) tests.
#

. $STF_SUITE/include/libtest.shlib
. $STF_SUITE/tests/functional/bclone_dedup/bclone_dedup.cfg

#
# Accumulate bclone_dedup stats from all lines in dbgmsg.
# For recursive receives, each child produces its own stats line;
# we sum hits/misses/deferred/bytes and take the last index_entries.
# Returns: "hits misses deferred_misses bytes_cloned index_entries"
#
function get_bclone_dedup_stats
{
	typeset lines
	lines=$(cat /proc/spl/kstat/zfs/dbgmsg 2>/dev/null | \
	    grep "dmu_recv.c:.*bclone_dedup:")
	if [[ -z "$lines" ]]; then
		echo "0 0 0 0 0"
		return
	fi
	typeset total_hits=0 total_misses=0 total_deferred=0 total_bytes=0
	typeset last_entries=0
	while read line; do
		typeset h=$(echo "$line" | \
		    sed -n 's/.*: \([0-9]*\) hits.*/\1/p')
		typeset m=$(echo "$line" | \
		    sed -n 's/.* \([0-9]*\) misses.*/\1/p')
		typeset d=$(echo "$line" | \
		    sed -n 's/.*(\([0-9]*\) deferred).*/\1/p')
		typeset b=$(echo "$line" | \
		    sed -n 's/.* \([0-9]*\) bytes cloned.*/\1/p')
		typeset e=$(echo "$line" | \
		    sed -n 's/.* \([0-9]*\) index entries.*/\1/p')
		total_hits=$((total_hits + ${h:-0}))
		total_misses=$((total_misses + ${m:-0}))
		total_deferred=$((total_deferred + ${d:-0}))
		total_bytes=$((total_bytes + ${b:-0}))
		last_entries=${e:-0}
	done <<< "$lines"
	echo "$total_hits $total_misses $total_deferred $total_bytes $last_entries"
}

#
# Clear dbgmsg so previous test runs don't pollute stats.
#
function clear_bclone_dedup_stats
{
	echo 0 > /proc/spl/kstat/zfs/dbgmsg 2>/dev/null
}

#
# Parse bclone_dedup verbose output from stderr/stdout of "zfs recv -Bv".
# Returns: "hits misses index_entries"
#
function get_bclone_dedup_verbose_stats
{
	typeset output="$1"
	typeset line
	line=$(echo "$output" | grep "^bclone_dedup:" | tail -1)
	if [[ -z "$line" ]]; then
		echo "0 0 0 0"
		return
	fi
	typeset hits=$(echo "$line" | \
	    sed -n 's/.*: \([0-9]*\) blocks cloned.*/\1/p')
	typeset misses=$(echo "$line" | \
	    sed -n 's/.* \([0-9]*\) misses.*/\1/p')
	typeset entries=$(echo "$line" | \
	    sed -n 's/.* \([0-9]*\) index entries.*/\1/p')
	echo "${hits:-0} ${misses:-0} ${entries:-0}"
}

#
# Send a dataset/snapshot with given flags, receive with -B and optional
# extra flags.  Verifies the receive succeeds.
#
# Usage: send_recv_bclone <send_flags> <snap> <recv_flags> <dest>
#
function send_recv_bclone
{
	typeset send_flags=$1
	typeset snap=$2
	typeset recv_flags=$3
	typeset dest=$4

	log_must eval "zfs send $send_flags $snap | zfs recv -B $recv_flags $dest"
}
